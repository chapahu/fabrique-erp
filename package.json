{
  "name": "fabrique-erp",
  "private": true,
  "description": "Mini ERP pour une biscuiterie (projet d'apprentissage)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "npm run migrate --workspace apps/api",
    "db:seed": "npm run seed --workspace apps/api",
    "db:history": "npm run history --workspace apps/api",
    "setup": "npm run db:up && npm run db:migrate && npm run db:seed && npm run db:history",
    "test": "npm run test --workspace apps/api",
    "dev:api": "npm run dev --workspace apps/api",
    "dev:web": "npm run dev --workspace apps/web",
    "simulate": "npm run start --workspace apps/simulator",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}
