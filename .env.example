# Copier ce fichier en ".env" et adapter les valeurs.
# .env.example est versionné (il documente les variables), .env ne l'est jamais (il contient les vrais secrets).

POSTGRES_USER=erp
POSTGRES_PASSWORD=change-moi
POSTGRES_DB=fabrique_erp
POSTGRES_PORT=5432

# Port de l'API
API_PORT=3000

# URL de connexion utilisée par l'API et les scripts
DATABASE_URL=postgres://erp:change-moi@localhost:5432/fabrique_erp
