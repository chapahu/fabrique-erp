# Copier ce fichier en ".env" et adapter les valeurs.
# .env.example est versionné (il documente les variables), .env ne l'est jamais (il contient les vrais secrets).

POSTGRES_USER=erp
POSTGRES_PASSWORD=change-moi
POSTGRES_DB=fabrique_erp
POSTGRES_PORT=5432

# Port de l'API
API_PORT=3000

# MODE DÉMO : true = on choisit son rôle en un clic, SANS mot de passe.
# Pratique pour tester avec des données fictives. À mettre à false pour un usage réel.
DEMO_MODE=true

# Mot de passe des comptes de DÉMO créés par "npm run db:seed" (local uniquement)
DEMO_PASSWORD=cookie-demo-2026

# Compte utilisé par le simulateur pour se connecter à l'API
SIM_EMAIL=simulateur@fabrique.test

# URL de connexion utilisée par l'API et les scripts
DATABASE_URL=postgres://erp:change-moi@localhost:5432/fabrique_erp
